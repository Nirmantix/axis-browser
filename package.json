{
  "name": "chrome-devtools-axi",
  "version": "0.1.35",
  "packageManager": "pnpm@12.5.1",
  "description": "Axis Browser: fast, token-efficient Chrome automation for shared CDP workflows",
  "//private": "The package name is upstream's on npm (kunchenguid/chrome-devtools-axi) and is kept for compatibility — see docs/upstream_sync.md. This fork is distributed from GitHub, so publishing is blocked to prevent an accidental push to upstream's name. Git installs and npm pack are unaffected.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nirmantix/axis-browser.git"
  },
  "homepage": "https://github.com/Nirmantix/axis-browser#readme",
  "bugs": {
    "url": "https://github.com/Nirmantix/axis-browser/issues"
  },
  "keywords": [
    "chrome",
    "devtools",
    "browser",
    "cli",
    "agent",
    "axi",
    "axis-browser",
    "toon",
    "mcp"
  ],
  "bin": {
    "chrome-devtools-axi": "dist/bin/chrome-devtools-axi.js",
    "axis-browser": "dist/bin/chrome-devtools-axi.js",
    "axib": "dist/bin/chrome-devtools-axi.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');try{fs.chmodSync('dist/bin/chrome-devtools-axi.js',0o755)}catch(e){if(!e||e.code!=='ENOENT')throw e}\"",
    "dev": "tsx bin/chrome-devtools-axi.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "format": "prettier --write src bin test",
    "format:check": "prettier --check src bin test",
    "prepare": "pnpm run build"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@toon-format/toon": "^4.1.1",
    "axi-sdk-js": "^0.1.12",
    "chrome-devtools-mcp": "1.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
